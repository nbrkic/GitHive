<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.githive.controller.ChangesController"
      styleClass="changes-root">

    <Label text="CHANGES" styleClass="section-label"/>

    <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">

        <VBox spacing="10" style="-fx-padding: 14 12 12 12;">
            <Label text="Unstaged"/>
            <ListView fx:id="unstagedList" VBox.vgrow="ALWAYS"/>
            <HBox spacing="8">
                <Button text="Stage Selected" onAction="#handleStage" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Stage All" onAction="#handleStageAll" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox spacing="8">
                <Button text="Discard Selected" onAction="#handleDiscard" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-text-fill: #f85149;"/>
                <Button text="Ignore Selected" onAction="#handleIgnore" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>

        <VBox spacing="10" style="-fx-padding: 14 12 12 12;">
            <Label text="Staged"/>
            <ListView fx:id="stagedList" VBox.vgrow="ALWAYS"/>
            <Button text="Unstage Selected" onAction="#handleUnstage" maxWidth="Infinity"/>
            <TextField fx:id="commitMsg" promptText="Commit message"/>
            <CheckBox fx:id="amendCheck" text="Amend last commit" onAction="#handleAmendToggle"/>
            <Button fx:id="commitBtn" text="Commit" onAction="#handleCommit"
                    styleClass="accent" maxWidth="Infinity"/>
        </VBox>

    </SplitPane>

</VBox>
