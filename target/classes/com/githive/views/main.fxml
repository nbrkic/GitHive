<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.githive.controller.MainController">

    <top>
        <ToolBar>
            <Label text="GitHive" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>
            <MenuButton text="Repository">
                <items>
                    <MenuItem text="Init New Repository" onAction="#handleInitRepo"/>
                    <MenuItem text="Clone Repository" onAction="#handleCloneRepo"/>
                    <MenuItem fx:id="manageRemotesItem" text="Manage Remotes" onAction="#handleManageRemotes"/>
                    <MenuItem fx:id="closeRepoItem" text="Close Repository" onAction="#handleCloseRepo"/>
                    <MenuItem text="Clear Saved Credentials" onAction="#handleClearCredentials"/>
                </items>
            </MenuButton>
            <Button fx:id="configBtn" text="Config" onAction="#handleConfig"/>
            <Separator orientation="VERTICAL"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="openRepoBtn" text="Open Repo" onAction="#handleOpenRepo"/>
            <Button fx:id="refreshBtn" text="Refresh" onAction="#handleRefresh"/>
            <MenuButton fx:id="recentMenu" text="Recent">
                <items>
                    <MenuItem fx:id="noRecentItem" text="No recent repositories"/>
                </items>
            </MenuButton>
            <Button fx:id="changesBtn" text="Changes" onAction="#handleShowChanges"/>
            <Button fx:id="conflictsBtn" text="Conflicts" onAction="#handleConflicts"
                    style="-fx-text-fill: #f85149;"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="fetchBtn" text="Fetch" onAction="#handleFetch"/>
            <Button fx:id="pullBtn" text="Pull" onAction="#handlePull"/>
            <Button fx:id="pushBtn" text="Push" onAction="#handlePush"/>
            <Separator orientation="VERTICAL"/>
            <MenuButton fx:id="stashMenu" text="Stash">
                <items>
                    <MenuItem text="Stash Save" onAction="#handleStashSave"/>
                    <MenuItem text="Stash Pop" onAction="#handleStashPop"/>
                    <MenuItem text="Stash List" onAction="#handleStashList"/>
                </items>
            </MenuButton>
        </ToolBar>
    </top>

    <center>
        <StackPane>

            <!-- Welcome screen — shown when no repo is loaded -->
            <VBox fx:id="welcomePane" alignment="CENTER" spacing="16" styleClass="welcome-pane">
                <Label text="GitHive" styleClass="welcome-title"/>
                <Label text="Lightweight Git GUI client" styleClass="welcome-subtitle"/>
                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 32 0 0 0;">
                    <Button text="Open Repository" onAction="#handleOpenRepo" styleClass="welcome-btn"/>
                    <Button text="Clone Repository" onAction="#handleCloneRepo" styleClass="welcome-btn"/>
                    <Button text="Init New Repository" onAction="#handleInitRepo" styleClass="welcome-btn"/>
                </VBox>
                <Label text="Ctrl+O  ·  Open   |   Recent repositories → toolbar"
                       styleClass="welcome-hint"/>
                <VBox fx:id="welcomeRecentBox" spacing="4" alignment="CENTER"
                      style="-fx-padding: 24 0 0 0; -fx-max-width: 420;"/>
            </VBox>

            <!-- Main content — shown when a repo is loaded -->
            <SplitPane fx:id="mainSplit" dividerPositions="0.22">

                <VBox styleClass="sidebar" spacing="6">
                    <Label text="BRANCHES" styleClass="section-label"/>
                    <Button fx:id="newBranchBtn" text="+ New Branch" onAction="#handleNewBranch" maxWidth="Infinity"/>
                    <ListView fx:id="branchList" VBox.vgrow="ALWAYS"/>
                    <Label text="TAGS" styleClass="section-label"/>
                    <Button fx:id="newTagBtn" text="+ New Tag" onAction="#handleNewTag" maxWidth="Infinity"/>
                    <ListView fx:id="tagList" prefHeight="120"/>
                </VBox>

                <SplitPane orientation="VERTICAL" dividerPositions="0.6">
                    <VBox>
                        <TextField fx:id="searchField" promptText="Search commits..."/>
                        <TableView fx:id="commitTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="graphCol" text="Graph" prefWidth="120"/>
                                <TableColumn fx:id="hashCol"    text="Hash"    prefWidth="80"/>
                                <TableColumn fx:id="messageCol" text="Message" prefWidth="420"/>
                                <TableColumn fx:id="authorCol"  text="Author"  prefWidth="150"/>
                                <TableColumn fx:id="dateCol"    text="Date"    prefWidth="150"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <SplitPane dividerPositions="0.40">

                        <VBox styleClass="sidebar">
                            <Label text="CHANGED FILES" styleClass="section-label"/>
                            <ListView fx:id="fileList" VBox.vgrow="ALWAYS"/>
                        </VBox>

                        <VBox style="-fx-padding: 10;">
                            <Label text="DIFF" styleClass="section-label"/>
                            <ListView fx:id="diffView" styleClass="diff-view" VBox.vgrow="ALWAYS"/>
                        </VBox>

                    </SplitPane>

                </SplitPane>
            </SplitPane>

        </StackPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" spacing="16">
            <Label fx:id="statusLabel" text="Ready"/>
            <Label fx:id="branchLabel" text="" style="-fx-text-fill: #58a6ff; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>
