<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.githive.controller.MainController"
            style="-fx-background-color: #0d1b2a;">

    <top>
        <ToolBar>
            <Label text="GitHive" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="openRepoBtn" text="Open Repo" onAction="#handleOpenRepo"/>
            <Button text="Refresh" onAction="#handleRefresh"/>
            <MenuButton fx:id="recentMenu" text="Recent">
                <items>
                    <MenuItem fx:id="noRecentItem" text="No recent repositories"/>
                </items>
            </MenuButton>
            <Button text="Changes" onAction="#handleShowChanges"/>
            <Separator orientation="VERTICAL"/>
            <Button text="Pull" onAction="#handlePull"/>
            <Button text="Push" onAction="#handlePush"/>
            <Separator orientation="VERTICAL"/>
            <MenuButton text="Stash">
                <items>
                    <MenuItem text="Stash Save" onAction="#handleStashSave"/>
                    <MenuItem text="Stash Pop" onAction="#handleStashPop"/>
                    <MenuItem text="Stash List" onAction="#handleStashList"/>
                </items>
            </MenuButton>
        </ToolBar>
    </top>

    <center>
        <SplitPane dividerPositions="0.22">

            <VBox style="-fx-background-color: #0a1628; -fx-padding: 10;" spacing="6">
                <Label text="BRANCHES" style="-fx-text-fill: #4d6b8a; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <Button text="+ New Branch" onAction="#handleNewBranch" maxWidth="Infinity" style="-fx-font-size: 11;"/>
                <ListView fx:id="branchList" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;"/>
                <Label text="TAGS" style="-fx-text-fill: #4d6b8a; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <Button text="+ New Tag" onAction="#handleNewTag" maxWidth="Infinity" style="-fx-font-size: 11;"/>
                <ListView fx:id="tagList" prefHeight="120" style="-fx-background-color: transparent;"/>
            </VBox>

            <SplitPane orientation="VERTICAL" dividerPositions="0.6">

                <TableView fx:id="commitTable">
                    <columns>
                        <TableColumn fx:id="graphCol" text="Graph" prefWidth="120"/>
                        <TableColumn fx:id="hashCol"    text="Hash"    prefWidth="80"/>
                        <TableColumn fx:id="messageCol" text="Message" prefWidth="420"/>
                        <TableColumn fx:id="authorCol"  text="Author"  prefWidth="150"/>
                        <TableColumn fx:id="dateCol"    text="Date"    prefWidth="150"/>
                    </columns>
                </TableView>

                <SplitPane dividerPositions="0.28">

                    <VBox style="-fx-background-color: #0a1628; -fx-padding: 10;">
                        <Label text="CHANGED FILES" style="-fx-text-fill: #4d6b8a; -fx-font-size: 10; -fx-font-weight: bold;"/>
                        <ListView fx:id="fileList" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;"/>
                    </VBox>

                    <VBox style="-fx-padding: 10; -fx-background-color: #0d1b2a;">
                        <Label text="DIFF" style="-fx-text-fill: #4d6b8a; -fx-font-size: 10; -fx-font-weight: bold;"/>
                        <TextArea fx:id="diffView" editable="false" wrapText="false" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: #0a1220; -fx-text-fill: #cdd9e5; -fx-font-family: monospace; -fx-font-size: 12;"/>
                    </VBox>

                </SplitPane>


            </SplitPane>
        </SplitPane>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #0a1628; -fx-padding: 4 12;">
            <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: #4d6b8a;"/>
        </HBox>
    </bottom>

</BorderPane>
